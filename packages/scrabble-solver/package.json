{
  "name": "@scrabble-solver/scrabble-solver",
  "version": "2.17.0",
  "description": "Scrabble Solver 2 - App",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamilmielnik/scrabble-solver.git"
  },
  "author": {
    "name": "Kamil Mielnik",
    "email": "kamil@kamilmielnik.com",
    "url": "https://kamilmielnik.com"
  },
  "license": "CC BY-NC-ND 4.0",
  "bugs": {
    "url": "https://github.com/kamilmielnik/scrabble-solver/issues"
  },
  "homepage": "https://scrabble-solver.org",
  "scripts": {
    "build": "bun run generate-scss-types && env-cmd next build --webpack",
    "clean": "rimraf --glob .next/ 'src/**/*.module.scss.d.ts'",
    "debug": "NODE_OPTIONS='--inspect' next dev --webpack",
    "dev": "concurrently -n scss,next 'bun scripts/generate-scss-types.ts --watch' 'env-cmd next dev --webpack'",
    "generate-scss-types": "bun scripts/generate-scss-types.ts",
    "start": "env-cmd next start -p 3333",
    "test": "bun test --timeout 180000 src",
    "type-check": "bun run generate-scss-types && tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@kamilmielnik/gaddag": "^2.0.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@scrabble-solver/configs": "^2.17.0",
    "@scrabble-solver/constants": "^2.17.0",
    "@scrabble-solver/dictionaries": "^2.17.0",
    "@scrabble-solver/logger": "^2.17.0",
    "@scrabble-solver/solver": "^2.17.0",
    "@scrabble-solver/types": "^2.17.0",
    "@scrabble-solver/word-definitions": "^2.17.0",
    "classnames": "^2.5.1",
    "env-cmd": "^11.0.0",
    "include-media": "^2.0.0",
    "include-media-query-builder": "^1.1.0",
    "next": "^16.3.0",
    "normalize.css": "^8.0.1",
    "react": "^19.2.8",
    "react-cool-onclickoutside": "^1.7.0",
    "react-dom": "^19.2.8",
    "react-highlight-words": "^0.21.0",
    "react-modal": "^3.16.3",
    "react-redux": "^9.3.0",
    "react-window": "^2.3.0",
    "redux-saga": "^1.5.1",
    "store2": "^2.14.4",
    "use-debounce": "^10.1.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-webpack-plugin": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-highlight-words": "^0.20.1",
    "@types/react-modal": "^3.16.3",
    "@types/react-portal": "^4.0.7",
    "postcss": "^8.5.26",
    "sass": "^1.102.0"
  },
  "gitHead": "1e2d1ad49a288d4a44196d8e3336740da132c637"
}
