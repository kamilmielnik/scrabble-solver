# npm drops workspace dirs from the root tarball when publishing with --workspaces; bin/scrabble-solver.js runs packages/scrabble-solver
!packages/*
coverage/
**/node_modules/**
*.eslintcache
*.db
*.log
*.zip
.nx/
packages/scrabble-solver/.next/cache/
packages/scrabble-solver/.next/dev/
packages/scrabble-solver/public/service-worker.js.map
.claude/
.github/
playwright-report/
test-results/
todo.txt
